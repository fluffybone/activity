BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Необязательно: ID группы, которую нужно подключить сразу. Остальные группы
# подключаются автоматически при добавлении бота. Можно оставить пустым.
GROUP_CHAT_ID=

# ID владельца бота через запятую. Только этим пользователям доступны
# /chats и /unregister. Варианты опроса могут менять и админы групп.
ADMIN_IDS=

TIMEZONE=Europe/Moscow

# Ежедневный опрос
POLL_HOUR=20
POLL_MINUTE=0

# Еженедельный отчёт: mon, tue, wed, thu, fri, sat, sun
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_HOUR=21
WEEKLY_REPORT_MINUTE=0

# Мотивационное сообщение (по умолчанию понедельник в 11:00)
MOTIVATION_DAY=mon
MOTIVATION_HOUR=11
MOTIVATION_MINUTE=0

# Хранить ответы N дней (0 — хранить бессрочно). Старше — удаляются ночью.
RETENTION_DAYS=0

DB_PATH=activity.db
